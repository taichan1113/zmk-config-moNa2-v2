#include "mona2_kb.dtsi"
#include "mona2_pointer.dtsi"

/ {
 
    kscan0: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

&listner_peripheral {
    status = "okay";
    input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>
    , <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;
    // , <&zip_xy_scaler 1 10>;
    // , <&zip_xy_to_scroll_mapper>;
};