#include "mona2_kb.dtsi"
#include "mona2_pointer.dtsi"
#include <input/processors/xyz.dtsi>


/{

  kscan0: mat_kscan_0 {
    compatible = "zmk,kscan-gpio-matrix";
    diode-direction = "col2row";
    row-gpios
    = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
    , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
    , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
    , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 			
    ;
    col-gpios
    = <&xiao_d 10 GPIO_ACTIVE_HIGH>
    , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
    , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
    , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
    , <&gpio0 10 GPIO_ACTIVE_HIGH>
    ;
  };
};

&default_transform {
    col-offset = <6>;
};


&spi0 {
    status = "okay";

    trackball: trackball@0 {
    status = "okay";
    compatible = "pixart,paw3222";  //トラボセンサ用のドライバとバインド
    reg = <0>;
    spi-max-frequency = <2000000>;
    irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; //P0.02を指定(MOTION)
    res-cpi = <800>;
    force-awake;
};
};


// Overrides for the input listener node
&trackball_split {
    status = "okay";
    device = <&trackball>;
    input-processors = <&zip_xyz>;
};
